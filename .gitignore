# --- Build folder and binaries ---
target/
build/
*.class
*.jar
*.war
*.ear
.env

# --- Maven / Gradle wrapper ---
.mvn/wrapper/maven-wrapper.jar
.gradle/
bin/

# --- IDEs (IntelliJ, Eclipse, VS Code, NetBeans) ---
.idea/
*.iml
*.iws
*.ipr
.classpath
.project
.settings/
.factorypath
.springBeans
.sts4-cache
.vscode/
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# --- Sensitive Configuration (CRITICAL) ---
# application.properties is tracked: it must only contain ${ENV_VAR} placeholders, never secrets.
# Local credentials go in application-local.properties (ignored).
.env
*.properties
*.yml
!inventory-backend/src/main/resources/application.properties
!inventory-backend/.mvn/wrapper/maven-wrapper.properties

# Critical exceptions so Git tracks infrastructure
!docker-compose.yml
!Dockerfile

# --- Local Docker Data ---
docker-data/
.docker/

# --- Python ---
__pycache__/
*.pyc

# --- Excel originales y salidas del script de análisis (datos reales) ---
data/
*_revision.xlsx
*_perfiles.json

# --- Database / Dumps ---
# init.sql is a real data dump: never commit it. Schema migrations are tracked.
database/*
!database/migrations/
*.sql
!database/migrations/*.sql
*.sqlite
*.db

# --- System and Logs ---
*.log
.DS_Store
Thumbs.db
temp/